// ESPERADO: RECHAZADO
// REGLA: I4
// Caso incorrecto: ENCENDER exige un ACTUADOR, pero HUMEDAD_SUELO se declaró
// como SENSOR. Es la equivocación típica de confundir una medición con un
// equipo — produce dos errores relacionados: I4 (uso en rol incorrecto) y
// T8 (ACCION_ESTADO sobre SENSOR).

CULTIVO CANA;
SENSOR HUMEDAD_SUELO;

SI HUMEDAD_SUELO < 30
  ENCENDER HUMEDAD_SUELO;
