// ESPERADO: RECHAZADO
// REGLA: T6
// Caso incorrecto: se compara una medición (SENSOR) contra un equipo
// (ACTUADOR). No tiene sentido preguntar si la humedad "es menor que" la
// bomba de riego.

CULTIVO CANA;
SENSOR HUMEDAD_SUELO;
ACTUADOR BOMBA_PRINCIPAL;

SI HUMEDAD_SUELO < BOMBA_PRINCIPAL
  ENCENDER BOMBA_PRINCIPAL;
