// Plantilla de sintaxis del lenguaje de Agrocode.
// Copien este archivo (o creen uno nuevo) para sus propios casos de prueba;
// el CLI (npm run analyze -- examples/) recorre todos los .agro de esta carpeta.
//
// Todo SENSOR/ACTUADOR usado en una regla debe declararse antes.
// Identificadores válidos aquí (dispositivo de ejemplo, src/compiler/exampleDevice.ts):
//   SENSORES:  HUMEDAD_SUELO, TEMPERATURA, HUMEDAD_AIRE, LLUVIA
//   ACTUADORES: BOMBA_PRINCIPAL, VALVULA_NORTE, VALVULA_SUR, ALARMA
//   CULTIVO:   CANA

CULTIVO CANA;
SENSOR HUMEDAD_SUELO;
ACTUADOR BOMBA_PRINCIPAL;

SI HUMEDAD_SUELO < 30
  ENCENDER BOMBA_PRINCIPAL;
